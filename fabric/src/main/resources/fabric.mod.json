{
  "schemaVersion": 1,
  "id": "todo",
  "version": "${version}",
  "name": "Todo",
  "description": "Simple Configurable Todo Mod",
  "authors": [
    "Space_Mex"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "MIT",
  "icon": "assets/todo/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.github.spacemex.fabric.TodoModFabric"
    ],
    "client": [
      "com.github.spacemex.fabric.client.TodoModFabricClient"
    ]
  },
  "mixins": [
    "todo.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": ">=1.20",
    "java": ">=17",
    "architectury": ">=9.2.14",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
